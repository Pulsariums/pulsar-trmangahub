<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Aniyomi/Kototoro eklenti tanıma bayrağı.
         Kototoro: AniyomiExtensionLoader.EXTENSION_FEATURE = "tachiyomi.animeextension" -->
    <uses-feature
        android:name="tachiyomi.animeextension"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:label="Pulsar Video">

        <!-- Kototoro/Aniyomi fabrika ve kaynak sınıfı anahtarları:
             tachiyomi.animeextension.class / .factory / .nsfw -->
        <meta-data
            android:name="tachiyomi.animeextension.class"
            android:value="eu.kanade.tachiyomi.animeextension.all.pulsarvideo.PulsarVideoSource" />

        <meta-data
            android:name="tachiyomi.animeextension.factory"
            android:value="eu.kanade.tachiyomi.animeextension.all.pulsarvideo.PulsarVideoSourceFactory" />

        <meta-data
            android:name="tachiyomi.animeextension.nsfw"
            android:value="0" />
    </application>

</manifest>
