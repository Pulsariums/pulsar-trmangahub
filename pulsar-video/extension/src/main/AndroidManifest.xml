<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Aniyomi/Kototoro eklenti tanıma bayrağı.
         Kototoro: AniyomiExtensionLoader.EXTENSION_FEATURE = "tachiyomi.animeextension" -->
    <uses-feature
        android:name="tachiyomi.animeextension"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:label="Pulsar Video">

        <!-- ZORUNLU: yükleyici bu sınıfı no-arg kurucu ile örnekler, sonra
             `as? AnimeSource` / `as? AnimeSourceFactory` yapar. Bu yüzden
             kaynak sınıfı (PulsarVideoSource, kurucusu (JSONObject, String))
             DEĞİL fabrika yazılır — manga tarafındaki `PulsarSourceFactory`
             deseninin aynısı. Gerçek Aniyomi APK'larında `.factory` anahtarı
             yoktur; çift örneklemeyi önlemek için burada da yok. -->
        <meta-data
            android:name="tachiyomi.animeextension.class"
            android:value="eu.kanade.tachiyomi.animeextension.all.pulsarvideo.PulsarVideoSourceFactory" />

        <meta-data
            android:name="tachiyomi.animeextension.nsfw"
            android:value="0" />

        <!-- Görünen ad ve ABI sürümü (Aniyomi manifest anahtarları).
             extensionLib sayı olarak verilir; yükleyici Float/Double bekler. -->
        <meta-data
            android:name="aniyomix.name"
            android:value="Pulsar Video" />

        <meta-data
            android:name="aniyomix.extensionLib"
            android:value="${pulsarExtLib}" />
    </application>

</manifest>
