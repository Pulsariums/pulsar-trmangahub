+fn load_runtime_filters(root: &Path) -> (std::collections::HashSet<String>, std::collections::HashSet<String>) {
+    let mut ds = std::collections::HashSet::new();
+    let mut dh = std::collections::HashSet::new();
+    let path = root.join("pulsar-v2/extension/src/main/assets/patches.json");
+    if let Some(v) = std::fs::read_to_string(&path).ok().and_then(|t| serde_json::from_str::<serde_json::Value>(&t).ok()) {
+        for x in v.get("deadSources").and_then(|a| a.as_array()).into_iter().flatten() {
+            if let Some(n) = x.as_str() { ds.insert(n.to_string()); }
+        }
+        for x in v.get("deadHosts").and_then(|a| a.as_array()).into_iter().flatten() {
+            if let Some(h) = x.as_str() { dh.insert(h.to_lowercase().trim_start_matches("www.").to_string()); }
+        }
+    }
+    (ds, dh)
+}
